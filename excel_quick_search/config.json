{
  "shortcuts": {
    "global": ["Ctrl+Alt+2"], // 全局唤起
    // 窗口内快捷键
    "hide": "Esc",
    "focus": "Ctrl+F",
    "open": "Enter",
    "reveal": "Ctrl+Enter",
    "copy": "Ctrl+Shift+C",
    "reload": "F5"
  },

  // 搜索位置，path 填表格目录或文件
  "sources": [
    { "key": "1", "name": "我的表格1", "path": "" },
    { "key": "2", "name": "我的表格1", "path": "" }
  ],

  // 其他设置
  "appName": "Excel 快速搜索",
  "tool": { "mode": "resident" },
  "window": { "width": 780, "height": 540, "theme": "light", "on_top": true },

  // 扫描规则，max_depth 为 0 时扫描所有子目录
  "search": {
    "extensions": [".xlsx", ".xls", ".xlsm", ".xlsb"],
    "skip_prefix": ["_win_"],
    "max_results": 5000,
    "max_depth": 0
  },
  "open": {
    "prefer_shower": false,
    "shower_dir": "../excel_shower"
  }
}
