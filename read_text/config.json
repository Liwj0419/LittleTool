{
  "shortcuts": {
    "global": "Alt+F1", // 全局唤起
    // 窗口内快捷键
    "cancel": "Esc",
    "copy": "Ctrl+C",
    "all": "Ctrl+A"
  },

  // 其他设置
  "appName": "屏幕取字",
  "tool": { "mode": "background" },
  "overlay": {
    "selectionColor": "rgba(0,120,215,0.32)",
    "hintColor": "rgba(20,20,20,0.82)",
    "showHint": true,
    "hintText": "拖动选择文字，按 Ctrl+C 复制；Esc 退出"
  },

  // 文字识别参数，upscale 可设为 1 至 3
  "ocr": {
    "upscale": 3,
    "joinGap": 0.28
  },
  "behavior": {
    "copyOnRelease": false,
    "closeOnOutsideClick": false,
    "maxAreaRatio": 0.9
  }
}
