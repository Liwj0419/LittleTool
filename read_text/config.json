{
  "tool": { "mode": "background" },
  // 中文名：Manager 用它显示这个软件（英文名就是文件夹名）
  "appName": "屏幕取字",
  // 按下这个键，锁定鼠标指针下的窗口并进入取字模式
  "shortcuts": {
    "global": "Alt+F1",           // 唤起 / 锁定鼠标下的窗口（唯一的全局键）
    "cancel": "Esc",          // 退出取字模式（不复制）；窗口有焦点时才生效
    "copy":   "Ctrl+C",       // 选中文字后按它复制，复制完才收起（窗口内）
    "all":    "Ctrl+A"        // 全选当前图片里的文字（窗口内）
  },

  // 覆盖层外观
  "overlay": {
    "selectionColor": "rgba(0,120,215,0.32)",  // 拖选时的高亮底色
    "hintColor": "rgba(20,20,20,0.82)",        // 顶部提示条底色
    "showHint": true,                         // 是否显示拖选说明和选中字符数
    "hintText": "拖动选择文字，按 Ctrl+C 复制；Esc 退出"
  },

  // 识别参数
  "ocr": {
    "upscale": 3,        // 小图送识别前放大几倍（1-3），提升小字识别率；超过 1600px 的图不会再放大
    "joinGap": 0.28      // 两个字块间距超过「字宽 × 该值」才补空格
  },

  // 行为
  "behavior": {
    "copyOnRelease": false,       // 松手不复制，等你按 Ctrl+C
    "closeOnOutsideClick": false, // 点空白也不退出：只有「复制」或「Esc」才收起
    "maxAreaRatio": 0.9          // 目标区域超过整屏这个比例时仍然照做
  }
}
