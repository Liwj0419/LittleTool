{
  "shortcuts": {
    "global": "Ctrl+Alt+3", // 全局唤起
    // 窗口内快捷键
    "hide": "Esc",
    "open": "Ctrl+O",
    "search": "Ctrl+F",
    "reload": "F5",
    "selectAll": "Ctrl+A",
    "copy": "Ctrl+C"
  },

  // 其他设置
  "appName": "Excel 数据查看器",
  "tool": { "mode": "resident" },
  "window": { "width": 1100, "height": 680, "minWidth": 820, "minHeight": 520 },

  // close 直接收起，layered 逐层退出
  "esc": "close",

  // 查看器的本地通信端口
  "port": 47653,
  "maxRows": 200000,
  "pageRows": 2000,
  "maxRecent": 8
}
