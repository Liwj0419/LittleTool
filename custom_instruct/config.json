{
  "shortcuts": {
    "global": "Ctrl+Alt+1", // 全局唤起
    // 窗口内快捷键
    "hide": "Esc",
    "run": "Enter",
    "next": "Down",
    "prev": "Up",
    "page_next": "PageDown",
    "page_prev": "PageUp",
    "reload": "F5",
    "edit": "Ctrl+O"
  },

  // 指令列表，path 填要打开的文件或目录
  "commands": [
    { "name": "系统盘", "command": "open", "path": "%SystemDrive%/" },
    { "name": "用户文件夹", "command": "open", "path": "%USERPROFILE%" }
  ],

  // 其他设置
  "appName": "指令启动器",
  "tool": { "mode": "resident" },
  "window": { "width": 400, "height": 380 },
  "theme": "auto",
  "behavior": {
    "hide_on_blur": true,
    "always_on_top": true,
    "beep_on_miss": true
  }
}
