{
  "shortcuts": {
    "global": "Ctrl+Alt+4", // 全局唤起
    // 窗口内快捷键
    "hide": "Esc",
    "focus": "Ctrl+F",
    "translate": "Ctrl+Enter",
    "clear": "Ctrl+L",
    "copy": "Ctrl+Shift+C"
  },

  // 其他设置
  "appName": "轻翻译",
  "tool": { "mode": "resident" },
  "window": { "width": 500, "height": 600 },

  // 输入文字会发送给已启用的在线服务
  "providers": [
    {
      "id": "mymemory",
      "name": "MyMemory",
      "enabled": true,
      "url": "https://api.mymemory.translated.net/get"
    }
  ]
}
