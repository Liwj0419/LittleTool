{
  "appName": "工具箱管理器",
  "tool": { "mode": "resident" },
  // 窗口尺寸（只决定首次启动的大小，之后拖多大就是多大；窗口不能最大化）
  "window": { "width": 900, "height": 620, "minWidth": 740, "minHeight": 460 },

  // 界面配色：auto（跟随系统）/ dark / light
  "theme": "auto",

  // 快捷键。留空、删掉整行或者注释掉，就表示不用这个快捷键。
  // 各软件自己的唤出键在它们自己的 config.json 里（应用启动器的 Alt+Space 就在
  // ../search_app/config.json），这里只管 Manager 自己。
  "shortcuts": {
    "global":     "Ctrl+Alt+0",   // 全局唤出 / 收起 Manager
    "hide":       "Esc"           // 收起窗口（进程留在托盘）
  },

  // 行为
  "behavior": {
    "hideOnBlur": false,      // 点到别处是否自动收起（管理器一般不收）
    "pollMs":     1500,       // 多久刷新一次运行状态
    "closeToTray": true       // 点关闭是收进托盘还是退出
  },

  // 要展示的软件：键是工具目录名，值是展示名。**只有写在这里的才会出现**，
  // 写了但目录里没有 app.py 的也不显示；顺序就是列表顺序。
  "apps": {
    "custom_instruct": { "name": "自定义指令" },
    "excel_quick_search": { "name": "搜索EXCEL" },
    "excel_shower": { "name": "显示EXCEL" },
    "read_text": { "name": "屏幕取字" },
    "translation": { "name": "翻译" },
  }
}
